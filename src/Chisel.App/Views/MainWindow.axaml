<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Chisel.App.ViewModels"
        xmlns:conv="using:Chisel.App.Converters"
        xmlns:convA="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
        x:Class="Chisel.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Background="{StaticResource WindowBackgroundBrush}"
        Title="Chisel">

    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding Settings.CloseCommand}" />
    </Window.KeyBindings>

    <Grid RowDefinitions="Auto,*" Margin="20" ColumnDefinitions="*">
        <Button Grid.Row="0" Name="SettingsButton" Classes="gearButton"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                ToolTip.Tip="Settings" Command="{Binding Settings.ToggleCommand}">
            <Path Width="20" Height="20" Stretch="Uniform" Fill="{StaticResource DimTextBrush}"
                  Data="M10.13,4.22 L10.52,1.60 L13.48,1.60 L13.87,4.22 L16.18,5.18 L18.30,3.60 L20.40,5.70 L18.82,7.82 L19.78,10.13 L22.40,10.52 L22.40,13.48 L19.78,13.87 L18.82,16.18 L20.40,18.30 L18.30,20.40 L16.18,18.82 L13.87,19.78 L13.48,22.40 L10.52,22.40 L10.13,19.78 L7.82,18.82 L5.70,20.40 L3.60,18.30 L5.18,16.18 L4.22,13.87 L1.60,13.48 L1.60,10.52 L4.22,10.13 L5.18,7.82 L3.60,5.70 L5.70,3.60 L7.82,5.18 Z M15.20,12 A3.2,3.2 0 1 0 8.80,12 A3.2,3.2 0 1 0 15.20,12 Z" />
        </Button>

        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="{Binding Clock.TimeText}" FontSize="36" FontWeight="Bold" />
                <TextBlock Text="{Binding Clock.Now, StringFormat='{}{0:dddd, MMMM d}'}" FontSize="20" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="dim" Text="{Binding Schedule.CurrentBlockTitle, StringFormat='Now: {0}'}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="1.3*,16,*">
            <!-- Schedule timeline -->
            <Border Grid.Column="0" Classes="card">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="cardHeading" Text="Today" />
                        <Button Grid.Column="1" Content="Edit schedule" Command="{Binding OpenScheduleEditorCommand}" />
                    </Grid>
                    <TextBlock Classes="empty" Text="Nothing scheduled"
                               IsVisible="{Binding Schedule.Timeline.Count, Converter={x:Static conv:IsZeroConverter.Instance}}" />
                    <ScrollViewer>
                        <ItemsControl Name="ScheduleList" ItemsSource="{Binding Schedule.Timeline}" Grid.IsSharedSizeScope="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScheduleTimelineEntry">
                                    <Border Classes="timelineRow" Classes.current="{Binding IsCurrent}" Classes.past="{Binding IsPast}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="TimeColumn" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Classes="timeLabel" Text="{Binding TimeLabel}" Margin="0,0,12,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Tasks, Notes, Quick links: scrolls so the inputs stay reachable on short windows -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Name="SidePanel" Spacing="16" Margin="0,0,14,0">
                <Border Classes="card">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="cardHeading" Text="Tasks" />
                            <Button Grid.Column="1" Content="Clear completed" Command="{Binding Tasks.ClearCompletedCommand}" />
                        </Grid>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="4" Margin="0,10,0,0">
                            <TextBox Text="{Binding Tasks.NewTaskText}" PlaceholderText="New task" Width="160">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding Tasks.AddTaskCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <Button Content="Add" Command="{Binding Tasks.AddTaskCommand}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Classes="empty" Text="No tasks yet"
                                       IsVisible="{Binding Tasks.Tasks.Count, Converter={x:Static conv:IsZeroConverter.Instance}}" />
                            <ItemsControl Name="TaskItemsControl" ItemsSource="{Binding Tasks.Tasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                            <CheckBox IsChecked="{Binding IsDone}"
                                                      Command="{Binding #TaskItemsControl.((vm:MainViewModel)DataContext).Tasks.ToggleCompleteCommand}"
                                                      CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding Text}" Classes.done="{Binding IsDone}" VerticalAlignment="Center" />
                                            <Button Classes="iconButton" Content="x"
                                                    Command="{Binding #TaskItemsControl.((vm:MainViewModel)DataContext).Tasks.RemoveTaskCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Classes="card">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Classes="cardHeading" Text="Notes" />
                        <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,10,0,0">
                            <TextBox Text="{Binding Notes.NewNoteTitle}" PlaceholderText="Title" />
                            <TextBox Text="{Binding Notes.NewNoteBody}" PlaceholderText="Body" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Content="Save" Command="{Binding Notes.SaveNoteCommand}" />
                                <Button Content="Cancel" Command="{Binding Notes.CancelEditCommand}"
                                        IsVisible="{Binding Notes.EditingNoteId, Converter={x:Static convA:ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Classes="empty" Text="No notes yet"
                                       IsVisible="{Binding Notes.Notes.Count, Converter={x:Static conv:IsZeroConverter.Instance}}" />
                            <ItemsControl Name="NoteItemsControl" ItemsSource="{Binding Notes.Notes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NoteRow">
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                            <Button Classes="link" HorizontalAlignment="Left"
                                                    Command="{Binding #NoteItemsControl.((vm:MainViewModel)DataContext).Notes.SelectNoteCommand}"
                                                    CommandParameter="{Binding Note}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="White" />
                                                    <TextBlock Classes="dim" Text="{Binding Body}" />
                                                    <TextBlock Classes="dim" FontSize="11" Text="{Binding UpdatedLabel}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="iconButton" Content="x"
                                                    Command="{Binding #NoteItemsControl.((vm:MainViewModel)DataContext).Notes.RemoveNoteCommand}"
                                                    CommandParameter="{Binding Note}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Classes="card">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Classes="cardHeading" Text="Quick links" />
                        <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,10,0,0">
                            <TextBox Text="{Binding QuickLinks.NewLinkLabel}" PlaceholderText="Label" />
                            <TextBox Text="{Binding QuickLinks.NewLinkUrl}" PlaceholderText="https://..." />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Content="Save" Command="{Binding QuickLinks.SaveQuickLinkCommand}" />
                                <Button Content="Cancel" Command="{Binding QuickLinks.CancelEditCommand}"
                                        IsVisible="{Binding QuickLinks.EditingLinkId, Converter={x:Static convA:ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                            <TextBlock Classes="dim" Foreground="IndianRed" Text="{Binding QuickLinks.ErrorMessage}"
                                       IsVisible="{Binding QuickLinks.ErrorMessage, Converter={x:Static convA:ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Classes="empty" Text="No quick links yet"
                                       IsVisible="{Binding QuickLinks.QuickLinks.Count, Converter={x:Static conv:IsZeroConverter.Instance}}" />
                            <ItemsControl Name="QuickLinkItemsControl" ItemsSource="{Binding QuickLinks.QuickLinks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                            <Button Classes="link" Content="{Binding Label}"
                                                    Command="{Binding #QuickLinkItemsControl.((vm:MainViewModel)DataContext).QuickLinks.OpenQuickLinkCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Classes="iconButton" Content="e"
                                                    Command="{Binding #QuickLinkItemsControl.((vm:MainViewModel)DataContext).QuickLinks.SelectQuickLinkCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Classes="iconButton" Content="x"
                                                    Command="{Binding #QuickLinkItemsControl.((vm:MainViewModel)DataContext).QuickLinks.RemoveQuickLinkCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Settings panel: floats over the content, below the gear button -->
        <Border Grid.Row="0" Grid.RowSpan="2" Name="SettingsPanel" Classes="card settingsPanel"
                IsVisible="{Binding Settings.IsOpen}" ZIndex="10"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,44,0,0" Width="280">
            <StackPanel Spacing="10">
                <TextBlock Classes="cardHeading" Text="Settings" />
                <TextBlock Classes="dim" Text="Clock format" />
                <RadioButton GroupName="ClockFormat" Content="24-hour (13:05)" IsChecked="{Binding Settings.UseTwentyFourHour}" />
                <RadioButton GroupName="ClockFormat" Content="12-hour (1:05 PM)" IsChecked="{Binding Settings.UseTwelveHour}" />
                <Button Content="Close" HorizontalAlignment="Right" Command="{Binding Settings.CloseCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
