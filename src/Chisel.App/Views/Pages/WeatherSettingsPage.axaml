<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Chisel.App.ViewModels"
             xmlns:core="using:Chisel.Core.Weather"
             x:Class="Chisel.App.Views.Pages.WeatherSettingsPage"
             x:DataType="vm:MainViewModel">
    <StackPanel Spacing="10">
        <TextBlock Classes="settingsSection" Text="LOCATION" />
        <TextBlock Name="WeatherChosen" Text="{Binding WeatherSettings.ChosenText}" />
        <AutoCompleteBox Name="WeatherSearchBox" Watermark="Search for a place"
                         FilterMode="None" MinimumPrefixLength="3" MinimumPopulateDelay="0"
                         MaxDropDownHeight="240"
                         Text="{Binding WeatherSettings.Query}"
                         SelectedItem="{Binding WeatherSettings.SelectedResult}">
            <AutoCompleteBox.ItemTemplate>
                <DataTemplate x:DataType="core:GeocodingResult">
                    <TextBlock Text="{Binding DisplayText}" />
                </DataTemplate>
            </AutoCompleteBox.ItemTemplate>
        </AutoCompleteBox>
        <Button Name="WeatherClearButton" Content="Clear location" HorizontalAlignment="Left" Command="{Binding WeatherSettings.ClearCommand}" />
        <TextBlock Name="WeatherCredit" Text="{Binding WeatherSettings.Credit}" Opacity="0.6" FontSize="11" />
    </StackPanel>
</UserControl>
