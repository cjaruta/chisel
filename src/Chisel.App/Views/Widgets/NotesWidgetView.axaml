<w:WidgetView xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vm="using:Chisel.App.ViewModels"
              xmlns:core="using:Chisel.Core.Notes"
              xmlns:w="using:Chisel.App.Views.Widgets"
              x:Class="Chisel.App.Views.Widgets.NotesWidgetView"
              x:DataType="vm:MainViewModel">

    <w:WidgetView.Styles>
        <Style Selector="TextBox.padEditor">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="AcceptsTab" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="0" />
            <!-- A quiet surface with room to breathe; colors come from the theme tokens, so every mode follows. -->
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="22" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource DragPreviewBrush}" />
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="PlaceholderForeground" Value="{DynamicResource DimTextBrush}" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <!-- A very short card: less padding so a whole line of text shows -->
        <Style Selector="TextBox.padEditor.short">
            <Setter Property="Padding" Value="14,6" />
        </Style>
        <Style Selector="TextBox.padEditor /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBox.padEditor:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HoverLineBrush}" />
        </Style>
        <Style Selector="TextBox.padEditor:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
        </Style>
        <Style Selector="TextBox.padEditor.nowrap">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style Selector="TextBox.padEditor.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New, monospace" />
        </Style>
    </w:WidgetView.Styles>

    <DockPanel Name="NotepadRoot" Margin="16,14,16,16">
        <!-- Pad switcher: always shown, with or without the card's title bar -->
        <Grid DockPanel.Dock="Top" Name="PadBar" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,10">
            <TextBlock Classes="dim" Text="Pad" VerticalAlignment="Center" />
            <ComboBox Name="PadPicker" Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="60"
                      ItemsSource="{Binding Notes.Pads}" SelectedItem="{Binding Notes.SelectedPad}"
                      AutomationProperties.Name="Pad">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="core:Note">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Name="NewPadButton" Grid.Column="2" Content="New" Command="{Binding Notes.NewPadCommand}"
                    ToolTip.Tip="Start a new pad" />
            <Button Name="PadMenuButton" Grid.Column="3" Content="More" ToolTip.Tip="Rename, delete, open or save a text file, view options">
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Name="RenamePadItem" Header="Rename pad…" Command="{Binding Notes.BeginRenameCommand}" />
                        <MenuItem Name="DeletePadItem" Header="Delete pad…" Command="{Binding Notes.RequestDeleteCommand}" />
                        <Separator />
                        <MenuItem Name="OpenFileItem" Header="Open text file…" Command="{Binding Notes.OpenTextFileCommand}" />
                        <MenuItem Name="SaveFileItem" Header="Save as text file…" Command="{Binding Notes.SaveAsTextFileCommand}" />
                        <Separator />
                        <MenuItem Name="MonospaceItem" Header="Monospace font" ToggleType="CheckBox" IsChecked="{Binding Notes.Monospace, Mode=TwoWay}" />
                        <MenuItem Name="WordWrapItem" Header="Word wrap" ToggleType="CheckBox" IsChecked="{Binding Notes.WordWrap, Mode=TwoWay}" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Rename: one line under the switcher; Enter keeps the name, Esc cancels -->
        <Grid DockPanel.Dock="Top" Name="RenameBar" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,10"
              IsVisible="{Binding Notes.IsRenaming}">
            <TextBox Name="RenameBox" Text="{Binding Notes.RenameText}" PlaceholderText="Pad name">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding Notes.CommitRenameCommand}" />
                    <KeyBinding Gesture="Escape" Command="{Binding Notes.CancelRenameCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <Button Name="RenameOkButton" Grid.Column="1" Classes="accent" Content="Rename" Command="{Binding Notes.CommitRenameCommand}" />
            <Button Name="RenameCancelButton" Grid.Column="2" Content="Cancel" Command="{Binding Notes.CancelRenameCommand}" />
        </Grid>

        <!-- Delete confirmation -->
        <Grid DockPanel.Dock="Top" Name="DeleteBar" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,10"
              IsVisible="{Binding Notes.IsConfirmingDelete}">
            <TextBlock Name="DeleteQuestion" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{Binding Notes.SelectedPad.Title, StringFormat='Delete “{0}” for good?'}" />
            <Button Name="DeleteConfirmButton" Grid.Column="1" Classes="accent" Content="Delete" Command="{Binding Notes.ConfirmDeleteCommand}" />
            <Button Name="DeleteCancelButton" Grid.Column="2" Content="Cancel" Command="{Binding Notes.CancelDeleteCommand}" />
        </Grid>

        <!-- A file action failed: nothing was lost -->
        <Grid DockPanel.Dock="Top" Name="NoticeBar" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,10"
              IsVisible="{Binding Notes.HasNotice}">
            <TextBlock Name="NoticeText" Text="{Binding Notes.Notice}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Name="NoticeDismissButton" Grid.Column="1" Classes="iconButton" Content="x" Command="{Binding Notes.DismissNoticeCommand}" />
        </Grid>

        <!-- The pad: one plain-text editor that takes all the room left -->
        <TextBox Name="PadEditor" Classes="padEditor" Text="{Binding Notes.Text}"
                 Classes.nowrap="{Binding !Notes.WordWrap}" Classes.mono="{Binding Notes.Monospace}"
                 PlaceholderText="Start typing…" AutomationProperties.Name="Pad text" />
    </DockPanel>
</w:WidgetView>
