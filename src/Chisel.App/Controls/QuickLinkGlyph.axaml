<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Chisel.App.ViewModels"
             x:Class="Chisel.App.Controls.QuickLinkGlyph"
             x:DataType="vm:QuickLinkItem"
             Width="20" Height="20">
    <!-- A website shows the first letter of its name; a folder and a document show a small outline icon. -->
    <Panel>
        <TextBlock Text="{Binding Initial}" IsVisible="{Binding IsWeb}" FontSize="14" FontWeight="Bold"
                   Foreground="{DynamicResource DimTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Path IsVisible="{Binding IsFolder}" Stretch="Uniform" Width="18" Height="18" Fill="Transparent"
              Stroke="{DynamicResource DimTextBrush}" StrokeThickness="1.6" StrokeJoin="Round"
              Data="M2,5 H8 L10,7 H16 V15 H2 Z" />
        <Path IsVisible="{Binding IsFile}" Stretch="Uniform" Width="18" Height="18" Fill="Transparent"
              Stroke="{DynamicResource DimTextBrush}" StrokeThickness="1.6" StrokeJoin="Round"
              Data="M4,2 H11 L14,5 V16 H4 Z M11,2 V5 H14" />
    </Panel>
</UserControl>
