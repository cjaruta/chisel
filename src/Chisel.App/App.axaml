<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chisel.App.App"
             xmlns:local="using:Chisel.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Theming/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- Widget frames: a card with the widget's heading row; list widgets scroll inside the card.
             The 2px border is always there (transparent) so the edit-mode outline never moves anything. -->
        <Style Selector="Border.widgetFrame">
            <Setter Property="Padding" Value="0" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- Layout edit mode: neutral hairline, soft shadow, a slight scale-down (render transform, so nothing
             moves), dimmed inert content. Not clipped. -->
        <Style Selector="Border.widgetFrame.editing">
            <Setter Property="BorderBrush" Value="{StaticResource EditHairlineBrush}" />
            <Setter Property="BoxShadow" Value="{StaticResource EditingCardShadow}" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>

        <Style Selector="Border.widgetFrame.editing > Panel">
            <Setter Property="RenderTransform" Value="scale(0.985)" />
        </Style>

        <Style Selector="Border.widgetFrame.editing :is(Panel).widgetContent">
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <!-- Adjusting a picture: the picture is live and at full strength -->
        <Style Selector="Border.widgetFrame.editing.adjusting :is(Panel).widgetContent">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- The drag surface: covers the whole widget -->
        <Style Selector="Border.editBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Cursor" Value="SizeAll" />
        </Style>

        <Style Selector="StackPanel.editBarContent">
            <Setter Property="Spacing" Value="10" />
            <Setter Property="Margin" Value="14,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Path.editGrip">
            <Setter Property="Fill" Value="{StaticResource DimTextBrush}" />
        </Style>

        <Style Selector="TextBlock.editTitle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Dragging a widget: a snapshot of it floats with the pointer (slightly larger, soft shadow), and its
             slot is an empty gap the other cards reflow around -->
        <Style Selector="Border.dragFloat">
            <Setter Property="BoxShadow" Value="{StaticResource DragFloatShadow}" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.16" Easing="CubicEaseOut" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.dragFloat.lifted">
            <Setter Property="BoxShadow" Value="{StaticResource DragLiftedShadow}" />
            <Setter Property="RenderTransform" Value="scale(1.035)" />
        </Style>

        <!-- The slot a dragged widget came from: one plain rounded box of the card's size, neutral outline, no
             shadow, no content. No transitions anywhere on the card: nothing eases, so nothing can be left behind. -->
        <Style Selector="Border.widgetFrame.dragSource">
            <Setter Property="BoxShadow" Value="none" />
            <Setter Property="BorderBrush" Value="{StaticResource EditHairlineBrush}" />
        </Style>

        <Style Selector="Border.widgetFrame.dragSource > Panel">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- The one drop preview shown while dragging: a translucent accent rectangle over the zone the widget would
             land in, with a short caption. Eases in over ~120 ms. -->
        <Style Selector="Border.dropPreview">
            <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="scale(0.98)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.dropPreview.active">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="none" />
        </Style>

        <Style Selector="Border.dropPreviewCaption">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="10,3" />
        </Style>

        <Style Selector="Border.dropPreviewCaption TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        </Style>

        <!-- Resize handles in the gaps between stacked cards: invisible outside edit mode; in edit mode a small
             neutral pill centered on the divider, brighter on hover and while dragging -->
        <Style Selector="Panel.resizeHandle Border.resizeLine">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="Panel.resizeHandle Border.resizeGrip">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource EditPillBrush}" />
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="Panel.resizeHandle.editing Border.resizeGrip">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="Panel.resizeHandle Border.resizeHit">
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Panel.resizeHandle.editing:pointerover Border.resizeGrip, Panel.resizeHandle.active Border.resizeGrip">
            <Setter Property="Background" Value="{StaticResource EditHairlineHoverBrush}" />
        </Style>

        <!-- Column resize handles: a slim vertical pill centered on the gap between two columns, shown only in
             edit mode; brighter on hover and while dragging -->
        <Style Selector="Panel.columnResizeHandle Border.columnResizeGrip">
            <Setter Property="Width" Value="4" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource EditPillBrush}" />
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="Panel.columnResizeHandle.editing Border.columnResizeGrip">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="Panel.columnResizeHandle.editing:pointerover Border.columnResizeGrip, Panel.columnResizeHandle.active Border.columnResizeGrip">
            <Setter Property="Background" Value="{StaticResource EditHairlineHoverBrush}" />
        </Style>

        <Style Selector="Panel.page.editing">
            <Setter Property="Background" Value="{StaticResource EditPageBrush}" />
        </Style>

        <!-- Daily verse actions: small quiet text buttons, brighter on hover or keyboard focus -->
        <Style Selector="Button.verseAction">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.verseAction /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
        </Style>
        <Style Selector="Button.verseAction:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.verseAction:focus-visible /template/ ContentPresenter#PART_ContentPresenter, Button.verseAction:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
        </Style>

        <!-- Remove badge: a small round "-" overlapping the widget's top-left corner; faded when it is the last widget -->
        <Style Selector="Button.removeWidget">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="8,8,0,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource EditBadgeBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource EditHairlineHoverBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- The title badge: the same round badge, just to the right of the remove badge -->
        <Style Selector="Button.removeWidget.headerBadge">
            <Setter Property="Margin" Value="28,8,0,0" />
        </Style>

        <Style Selector="Button.removeWidget.adjustBadge">
            <Setter Property="Margin" Value="48,8,0,0" />
        </Style>

        <Style Selector="Button.removeWidget Path">
            <Setter Property="Stroke" Value="{StaticResource TextBrush}" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeLineCap" Value="Round" />
        </Style>

        <Style Selector="Button.removeWidget:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HoverLineBrush}" />
        </Style>

        <Style Selector="Button.removeWidget:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.removeWidget:disabled Path">
            <Setter Property="Opacity" Value="0.3" />
        </Style>

        <!-- The widget library: a toolbar toggle and a floating panel of rows -->
        <Style Selector="Button.libraryToggle">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.libraryToggle.active">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="Border.libraryPanel">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource EditHairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style Selector="Border.libraryRow">
            <Setter Property="Background" Value="{StaticResource EditBarBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource EditHairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <Style Selector="Path.trayIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{StaticResource DimTextBrush}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.toolbarDivider">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="2,4" />
            <Setter Property="Background" Value="{StaticResource GridLineBrush}" />
        </Style>

        <Style Selector="Border.layoutToolbar">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource EditHairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,-14,0,0" />
            <Setter Property="BoxShadow" Value="{StaticResource ToolbarShadow}" />
        </Style>

        <!-- Done is the primary button; Cancel and Reset stay secondary (plain) -->
        <Style Selector="Button.editPrimary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.editPrimary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        </Style>

        <Style Selector="Button.editPrimary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        </Style>

        <!-- Clock tool buttons: three quiet kinds, all pills with hairline outlines. Chips set the time, ghost buttons act,
             the primary button (Start) is the one filled in the accent. -->
        <Style Selector="Button.clockChip /template/ ContentPresenter#PART_ContentPresenter, Button.clockGhost /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource EditHairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <Style Selector="Button.clockChip /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
        </Style>
        <Style Selector="Button.clockGhost /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="Button.clockChip:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.clockGhost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HoverWashBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource EditHairlineHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="Button.clockChip:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.clockGhost:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HoverWashBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource EditHairlineHoverBrush}" />
        </Style>
        <Style Selector="Button.clockChip:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.clockGhost:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource GridLineBrush}" />
            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
        </Style>
        <Style Selector="Button.clockPrimary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.clockPrimary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        </Style>
        <Style Selector="Button.clockPrimary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentPressedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        </Style>

        <!-- The one header bar shared by every widget card -->
        <Style Selector="Border.widgetHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBackgroundBrush}" />
            <Setter Property="Padding" Value="16,0,12,0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource GridLineBrush}" />
            <Setter Property="CornerRadius" Value="10,10,0,0" />
        </Style>

        <!-- Tabs in the shared header of a group: equal shares of the width, titles cut with an ellipsis.
             Active: accent text and an accent underline. Inactive: secondary text. -->
        <Style Selector="Button.groupTab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.groupTab /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.groupTab:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.groupTab:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HoverWashBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="Button.groupTab:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HoverWashBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="Button.groupTab.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="Button.groupTab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.groupTab.active:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="Grid.groupTabs">
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>

        <!-- The small button on a tab in edit mode that moves its widget back out of the group -->
        <Style Selector="Button.tabUnmerge">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,4,2" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{StaticResource EditBadgeBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource EditHairlineHoverBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.tabUnmerge Path">
            <Setter Property="Stroke" Value="{StaticResource TextBrush}" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="StrokeLineCap" Value="Round" />
        </Style>
        <Style Selector="Button.tabUnmerge:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HoverLineBrush}" />
        </Style>

        <!-- Reordering tabs in edit mode: the dragged tab fades, the tab it would swap with shows a wash -->
        <Style Selector="Grid.groupTabCell.tabDragging">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Grid.groupTabCell.tabDropTarget">
            <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
        </Style>

        <!-- A group in edit mode keeps its tabs bright: only the body is dimmed -->
        <Style Selector="Border.widgetFrame.editing.groupFrame :is(Panel).widgetContent">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.widgetFrame.editing.groupFrame Panel.widgetBody">
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <!-- Split view: the card itself is see-through and each pane is its own rounded card. Edit mode puts the
             hairline and shadow on the panes. -->
        <Style Selector="Border.widgetFrame.splitFrame">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.widgetFrame.splitFrame.editing">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BoxShadow" Value="none" />
        </Style>
        <Style Selector="Border.splitPane">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.widgetFrame.editing Border.splitPane">
            <Setter Property="BorderBrush" Value="{StaticResource EditHairlineBrush}" />
            <Setter Property="BoxShadow" Value="{StaticResource EditingCardShadow}" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>

        <!-- The tabs / split toggle: a small quiet icon button (theme tokens only) -->
        <Style Selector="Button.viewModeToggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.viewModeToggle /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.viewModeToggle Path">
            <Setter Property="Stroke" Value="{StaticResource DimTextBrush}" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Stretch" Value="None" />
        </Style>
        <Style Selector="Button.viewModeToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.viewModeToggle:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HoverWashBrush}" />
        </Style>
        <Style Selector="Button.viewModeToggle:pointerover Path, Button.viewModeToggle:focus-visible Path">
            <Setter Property="Stroke" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="Button.viewModeToggle:disabled Path">
            <Setter Property="Stroke" Value="{StaticResource DisabledTextBrush}" />
        </Style>

        <!-- The divider between panes: a thin pill in the gap, brighter on hover, focus and while dragging -->
        <Style Selector="Border.paneSplitterGrip">
            <Setter Property="Width" Value="3" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource HoverLineBrush}" />
        </Style>
        <Style Selector="Border.paneSplitter:pointerover Border.paneSplitterGrip, Border.paneSplitter:focus Border.paneSplitterGrip, Border.paneSplitter.dragging Border.paneSplitterGrip">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        </Style>

        <!-- Top-aligned so a list's input row stays right under the list, as before, when the card is taller -->
        <Style Selector=":is(UserControl).scrolledWidget">
            <Setter Property="Margin" Value="16,0,16,16" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <!-- No title bar above a list: leave room at the top for the edit-mode badges, so entering edit mode moves nothing -->
        <Style Selector=":is(UserControl).scrolledWidget.headerless">
            <Setter Property="Margin" Value="16,24,16,16" />
        </Style>

        <Style Selector="TextBlock#WeatherLocation">
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>

        <Style Selector=":is(UserControl).editingWidget.headerless TextBlock#WeatherLocation">
            <Setter Property="Margin" Value="38,10,0,0" />
        </Style>

        <Style Selector="TextBlock.cardHeading">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style Selector="TextBlock.empty">
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="TextBlock.dim">
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="TextBlock.done">
            <Setter Property="TextDecorations" Value="Strikethrough" />
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
        </Style>

        <Style Selector="Button.iconButton">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style Selector="Button.mediaButton">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style Selector="Button.mediaButton:disabled">
            <Setter Property="Opacity" Value="0.3" />
        </Style>

        <!-- Calculator keys: sizes come from the widget (CalculatorLayout); these set only the colors and the shape -->
        <Style Selector="Button.calcKey">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.calcKey /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.calcKey:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HoverLineBrush}" />
        </Style>
        <Style Selector="Button.calcKey:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ControlBorderBrush}" />
        </Style>
        <Style Selector="Button.calcKey.fn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HoverLineBrush}" />
        </Style>
        <Style Selector="Button.calcKey.fn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ControlBorderBrush}" />
        </Style>
        <Style Selector="Button.calcKey.op /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
        </Style>
        <Style Selector="Button.calcKey.op:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBorderBrush}" />
        </Style>
        <Style Selector="Button.calcKey.eq /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        </Style>
        <Style Selector="Button.calcKey.eq:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
        </Style>
        <Style Selector="Button.calcKey.eq:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
        </Style>
        <Style Selector="Button.calcKey.adv /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HeaderBackgroundBrush}" />
        </Style>
        <Style Selector="Button.calcKey.adv:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HoverWashBrush}" />
        </Style>

        <!-- Calendar: sizes come from the widget (CalendarLayout); these set only the colors and the shape -->
        <Style Selector="Button.calDay, Button.calNav, Button.calTitle">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.calDay">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.calNav">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.calTitle">
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style Selector="Button.calDay /template/ ContentPresenter#PART_ContentPresenter, Button.calNav /template/ ContentPresenter#PART_ContentPresenter, Button.calTitle /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.calDay:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.calNav:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.calTitle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HoverWashBrush}" />
        </Style>
        <Style Selector="Button.calNav:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.calTitle:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HoverLineBrush}" />
        </Style>
        <Style Selector="Button.calNav Path">
            <Setter Property="Stroke" Value="{StaticResource DimTextBrush}" />
        </Style>
        <Style Selector="Button.calNav:pointerover Path">
            <Setter Property="Stroke" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="Button.calDay.muted /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
        </Style>
        <Style Selector="Button.calDay.today /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.calDay.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="Button.calDay.today.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.calDay Ellipse.calDot">
            <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="Button.calDay.today.selected Ellipse.calDot">
            <Setter Property="Fill" Value="{StaticResource OnAccentBrush}" />
        </Style>
        <Style Selector="TextBlock.calWeekday">
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
        </Style>
        <Style Selector="TextBlock.calWeekNumber">
            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
        </Style>

        <!-- Countdown: sizes come from the widget (CountdownLayout); these set only colors and shape -->
        <Style Selector="Button.cdRow">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.cdRow /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="Button.cdRow:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.cdRow:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HoverWashBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="Button.cdRow.today /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
        </Style>
        <Style Selector="TextBlock.cdWhen">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.cdRow TextBlock.cdName, Button.cdRow TextBlock.cdLead, Button.cdRow TextBlock.cdWhen">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="Button.cdRow.past TextBlock.cdWhen">
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="Button.cdRow.today TextBlock.cdWhen, Button.cdRow.today TextBlock.cdLead">
            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
        </Style>
        <Style Selector="TextBlock.cdDim">
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
        </Style>
        <Style Selector="TextBlock.cdError">
            <Setter Property="Foreground" Value="{StaticResource ReminderBrush}" />
        </Style>
        <Style Selector="Button.cdSwatch">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="Button.cdSwatch /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.cdSwatch.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <!-- Habits: sizes come from the widget (HabitLayout); rows and swatches reuse the countdown styles -->
        <Style Selector="CheckBox.habitCheck">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ToggleButton.habitDay">
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <!-- Focus timer: sizes come from the widget (FocusLayout); these set only colors and shape -->
        <Style Selector="Button.focusButton">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.focusDim">
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
        </Style>
        <Style Selector="Button.focusTask">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.focusTask /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
        </Style>
        <Style Selector="Button.focusTask:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HoverWashBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style Selector="Button.gearButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6" />
        </Style>

        <Style Selector="Button.moreLink">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinWidth" Value="180" />
        </Style>

        <Style Selector="Button.gearButton Path">
            <Setter Property="Fill" Value="{StaticResource DimTextBrush}" />
        </Style>

        <Style Selector="Button.gearButton.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
        </Style>

        <!-- Disabled (the gear while editing): no grey box, just a faded icon -->
        <Style Selector="Button.gearButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.gearButton:disabled Path">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <Style Selector="Button.gearButton.active Path">
            <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
        </Style>

        <!-- Settings dialog: neutral chrome; amber marks only the selected tab -->
        <Style Selector="Border.settingsScrim">
            <Setter Property="Background" Value="{StaticResource ScrimBrush}" />
        </Style>

        <Style Selector="Border.settingsDialog">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HoverLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="BoxShadow" Value="{StaticResource DialogShadow}" />
        </Style>

        <Style Selector="Border.settingsSidebar">
            <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GridLineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style Selector="Button.settingsTab">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
        </Style>
        <Style Selector="Button.settingsTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HoverWashBrush}" />
        </Style>
        <Style Selector="Button.settingsTab.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style Selector="TextBlock.settingsSection">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.6" />
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style Selector="ListBox.paletteList">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="ListBox.paletteList ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource GridLineBrush}" />
        </Style>

        <Style Selector="ListBox.paletteList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HoverWashBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DimTextBrush}" />
        </Style>

        <Style Selector="Border.accentPreview">
            <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style Selector="Border.paletteChip">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="10" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>

        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Border.editorPanel">
            <Setter Property="Width" Value="320" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,10,14,0" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="{StaticResource FlyoutShadow}" />
        </Style>

        <!-- Clickable grid items: a bare button around a block or marker pill, no button chrome -->
        <Style Selector="Button.gridItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.gridItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.gridItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Button.gridItem:pressed">
            <Setter Property="RenderTransform" Value="{x:Null}" />
        </Style>

        <Style Selector="Button.gridItem:pointerover Border.gridBlock">
            <Setter Property="BorderBrush" Value="{StaticResource EditHairlineHoverBrush}" />
        </Style>

        <Style Selector="Button.gridItem:pointerover Border.markerPill">
            <Setter Property="Background" Value="{StaticResource GridLineBrush}" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Foreground" Value="IndianRed" />
        </Style>

        <Style Selector="TextBlock.editorError">
            <Setter Property="Foreground" Value="IndianRed" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Schedule day grid -->
        <Style Selector="Border.divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource GridLineBrush}" />
        </Style>

        <Style Selector="TextBlock.hourLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style Selector="Border.hourLine">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource GridLineBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Blocks: fill comes from the block's color; the inner border clips the stripe to the rounded corners -->
        <Style Selector="Border.gridBlock">
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Border.blockInner">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style Selector="Border.blockStripe">
            <Setter Property="Width" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style Selector="StackPanel.blockContent">
            <Setter Property="Margin" Value="11,3,8,3" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style Selector="Border.dragPreview TextBlock.blockTitle">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style Selector="Border.dragPreview TextBlock.blockTime">
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
        </Style>

        <!-- The current block keeps its own color and gets a bright outline and soft glow instead -->
        <Style Selector="Border.gridBlock.current">
            <Setter Property="BorderBrush" Value="{StaticResource CurrentBlockOutlineBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BoxShadow" Value="{StaticResource CurrentBlockGlow}" />
        </Style>

        <Style Selector="Border.gridBlock.past">
            <Setter Property="Opacity" Value="0.6" />
        </Style>

        <Style Selector="TextBlock.blockTitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style Selector="Border.gridBlock.current TextBlock.blockTitle">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        </Style>

        <Style Selector="TextBlock.blockTime">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style Selector="Line.markerLine">
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Stroke" Value="{StaticResource ReminderBrush}" />
            <Setter Property="StrokeDashArray" Value="1,3" />
        </Style>

        <Style Selector="Grid.markerRow.checkpoint Line.markerLine">
            <Setter Property="Stroke" Value="{StaticResource CheckpointBrush}" />
            <Setter Property="StrokeDashArray" Value="4,3" />
        </Style>

        <Style Selector="Border.markerPill">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ReminderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <Style Selector="Grid.markerRow.checkpoint Border.markerPill">
            <Setter Property="BorderBrush" Value="{StaticResource CheckpointBrush}" />
        </Style>

        <Style Selector="TextBlock.markerText">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource ReminderBrush}" />
        </Style>

        <Style Selector="Grid.markerRow.checkpoint TextBlock.markerText">
            <Setter Property="Foreground" Value="{StaticResource CheckpointBrush}" />
        </Style>

        <Style Selector="Grid.markerRow.past">
            <Setter Property="Opacity" Value="0.6" />
        </Style>

        <!-- A marker not saved yet: same look, a little softer -->
        <Style Selector="Grid.markerRow.pendingMarker">
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <!-- Hover guide line: faint, a step above the hour lines, never competing with the now-line -->
        <Style Selector="Border.hoverLine">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource HoverLineBrush}" />
        </Style>

        <Style Selector="Border.hoverLabel">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="3,0" />
        </Style>

        <Style Selector="Border.hoverLabel TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <!-- Drag-to-create preview: translucent accent box; a little stronger once it is pending in the editor -->
        <Style Selector="Border.dragPreview">
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="{StaticResource DragPreviewBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Pending: the editor's color shows through the fill and stripe; the accent outline marks it unsaved -->
        <Style Selector="Border.dragPreview.pending">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Color picker swatches: a small dot; the selected one gets a ring -->
        <Style Selector="Button.swatch">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.swatch:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource EditHairlineHoverBrush}" />
        </Style>

        <Style Selector="Button.swatch.selected /template/ ContentPresenter#PART_ContentPresenter, Button.swatch.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource CurrentBlockOutlineBrush}" />
        </Style>

        <Style Selector="Ellipse.swatchDot">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>

        <Style Selector="Border.nowLine">
            <Setter Property="Height" Value="2" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Ellipse.nowDot">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="-4,0,0,0" />
        </Style>

        <Style Selector="Border.nowPill">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style Selector="Border.nowPill TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        </Style>
    </Application.Styles>
</Application>
