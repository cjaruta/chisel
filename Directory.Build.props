<Project>
  <!-- The one place the version is set. The assembly, file and product versions come from it (without a build hash), and the
       app shows it in Settings > Help, backups and crash reports; scripts/package.ps1 reads it for the release file names. -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
