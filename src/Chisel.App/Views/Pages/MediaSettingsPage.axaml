<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Chisel.App.ViewModels"
             x:Class="Chisel.App.Views.Pages.MediaSettingsPage"
             x:DataType="vm:MainViewModel">
    <StackPanel Spacing="10">
        <TextBlock Classes="settingsSection" Text="VISUALIZER" />
        <CheckBox Name="MediaVisualizerToggle" Content="Show audio bars while music is playing"
                  IsChecked="{Binding MediaSettings.ShowVisualizer}" />
        <CheckBox Name="MediaVolumeToggle" Content="Show volume control"
                  IsChecked="{Binding MediaSettings.ShowVolume}" />
        <CheckBox Name="MediaScrollVolumeToggle" Content="Scroll to change volume"
                  IsChecked="{Binding MediaSettings.ScrollVolume}" />
        <TextBlock Classes="settingsSection" Text="BACKGROUND" />
        <CheckBox Name="MediaAlbumGradientToggle" Content="Album color background"
                  IsChecked="{Binding MediaSettings.AlbumGradient}" />
        <CheckBox Name="MediaAnimateGradientToggle" Content="Animate background"
                  IsEnabled="{Binding MediaSettings.AlbumGradient}"
                  IsChecked="{Binding MediaSettings.AnimateGradient}" />
    </StackPanel>
</UserControl>
