<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chisel.App.App"
             xmlns:local="using:Chisel.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <Color x:Key="WindowBackgroundColor">#14161A</Color>
        <Color x:Key="CardBackgroundColor">#1F222A</Color>
        <Color x:Key="AccentColor">#5B8DEF</Color>
        <Color x:Key="DimTextColor">#8A8F98</Color>

        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="DimTextBrush" Color="{StaticResource DimTextColor}" />
        <SolidColorBrush x:Key="GridLineBrush" Color="#2A2E37" />
        <SolidColorBrush x:Key="HoverLineBrush" Color="#3D4350" />
        <SolidColorBrush x:Key="DragPreviewBrush" Color="#405B8DEF" />
        <SolidColorBrush x:Key="PendingBlockBrush" Color="#665B8DEF" />
        <SolidColorBrush x:Key="BlockBackgroundBrush" Color="#C02B3350" />
        <SolidColorBrush x:Key="CurrentBlockBackgroundBrush" Color="#D0324A80" />
        <SolidColorBrush x:Key="CheckpointBrush" Color="#E06C75" />
        <SolidColorBrush x:Key="ReminderBrush" Color="#C9B77A" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style Selector="TextBlock.cardHeading">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style Selector="TextBlock.empty">
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="TextBlock.dim">
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="TextBlock.done">
            <Setter Property="TextDecorations" Value="Strikethrough" />
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
        </Style>

        <Style Selector="Button.iconButton">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style Selector="Button.gearButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6" />
        </Style>

        <Style Selector="Border.settingsPanel">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 6 24 0 #80000000" />
        </Style>

        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Border.editorPanel">
            <Setter Property="Width" Value="320" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,10,14,0" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 6 24 0 #80000000" />
        </Style>

        <!-- Clickable grid items: a bare button around a block or marker pill, no button chrome -->
        <Style Selector="Button.gridItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.gridItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.gridItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Button.gridItem:pressed">
            <Setter Property="RenderTransform" Value="{x:Null}" />
        </Style>

        <Style Selector="Button.gridItem:pointerover Border.gridBlock">
            <Setter Property="BorderThickness" Value="3,1,1,1" />
        </Style>

        <Style Selector="Button.gridItem:pointerover Border.markerPill">
            <Setter Property="Background" Value="{StaticResource GridLineBrush}" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Foreground" Value="IndianRed" />
        </Style>

        <Style Selector="TextBlock.editorError">
            <Setter Property="Foreground" Value="IndianRed" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Schedule day grid -->
        <Style Selector="Border.divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource GridLineBrush}" />
        </Style>

        <Style Selector="TextBlock.hourLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style Selector="Border.hourLine">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource GridLineBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.gridBlock">
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Padding" Value="10,4,8,4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="{StaticResource BlockBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
        </Style>

        <Style Selector="Border.gridBlock.current">
            <Setter Property="Background" Value="{StaticResource CurrentBlockBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="3,1,1,1" />
        </Style>

        <Style Selector="Border.gridBlock.past">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <Style Selector="TextBlock.blockTitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style Selector="Border.gridBlock.current TextBlock.blockTitle">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="TextBlock.blockTime">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style Selector="Line.markerLine">
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Stroke" Value="{StaticResource ReminderBrush}" />
            <Setter Property="StrokeDashArray" Value="1,3" />
        </Style>

        <Style Selector="Grid.markerRow.checkpoint Line.markerLine">
            <Setter Property="Stroke" Value="{StaticResource CheckpointBrush}" />
            <Setter Property="StrokeDashArray" Value="4,3" />
        </Style>

        <Style Selector="Border.markerPill">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ReminderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <Style Selector="Grid.markerRow.checkpoint Border.markerPill">
            <Setter Property="BorderBrush" Value="{StaticResource CheckpointBrush}" />
        </Style>

        <Style Selector="TextBlock.markerText">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource ReminderBrush}" />
        </Style>

        <Style Selector="Grid.markerRow.checkpoint TextBlock.markerText">
            <Setter Property="Foreground" Value="{StaticResource CheckpointBrush}" />
        </Style>

        <Style Selector="Grid.markerRow.past">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <!-- Hover guide line: faint, a step above the hour lines, never competing with the now-line -->
        <Style Selector="Border.hoverLine">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource HoverLineBrush}" />
        </Style>

        <Style Selector="Border.hoverLabel">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="3,0" />
        </Style>

        <Style Selector="Border.hoverLabel TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <!-- Drag-to-create preview: translucent accent box; a little stronger once it is pending in the editor -->
        <Style Selector="Border.dragPreview">
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Padding" Value="10,2,8,2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="{StaticResource DragPreviewBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Border.dragPreview.pending">
            <Setter Property="Background" Value="{StaticResource PendingBlockBrush}" />
        </Style>

        <Style Selector="Border.nowLine">
            <Setter Property="Height" Value="2" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Ellipse.nowDot">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="-4,0,0,0" />
        </Style>

        <Style Selector="Border.nowPill">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style Selector="Border.nowPill TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Application.Styles>
</Application>
