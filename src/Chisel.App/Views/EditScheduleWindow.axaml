<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Chisel.App.ViewModels"
        xmlns:convA="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="640"
        x:Class="Chisel.App.Views.EditScheduleWindow"
        x:DataType="vm:ScheduleEditorViewModel"
        Background="{StaticResource WindowBackgroundBrush}"
        Title="Edit schedule"
        Width="620" Height="640">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <TextBlock Grid.Row="0" Classes="cardHeading" Text="Edit schedule" Margin="0,0,0,8" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="Blocks" FontWeight="Bold" />
                    <ItemsControl Name="BlocksItemsControl" ItemsSource="{Binding Blocks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EditableBlockRow">
                                <StackPanel Margin="0,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBox Text="{Binding Title}" PlaceholderText="Title" Width="180" />
                                        <TextBox Text="{Binding Start}" PlaceholderText="HH:mm" Width="70" />
                                        <TextBlock Text="to" VerticalAlignment="Center" />
                                        <TextBox Text="{Binding End}" PlaceholderText="HH:mm" Width="70" />
                                        <Button Classes="iconButton" Content="x"
                                                Command="{Binding #BlocksItemsControl.((vm:ScheduleEditorViewModel)DataContext).RemoveBlockCommand}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <TextBlock Classes="dim" Foreground="IndianRed" Text="{Binding Error}"
                                               IsVisible="{Binding Error, Converter={x:Static convA:ObjectConverters.IsNotNull}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Add block" Command="{Binding AddBlockCommand}" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Markers" FontWeight="Bold" />
                    <ItemsControl Name="MarkersItemsControl" ItemsSource="{Binding Markers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EditableMarkerRow">
                                <StackPanel Margin="0,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBox Text="{Binding Label}" PlaceholderText="Label" Width="160" />
                                        <TextBox Text="{Binding Time}" PlaceholderText="HH:mm" Width="70" />
                                        <ComboBox SelectedItem="{Binding Kind}" ItemsSource="{x:Static vm:MarkerKindOptions.All}" Width="120" />
                                        <Button Classes="iconButton" Content="x"
                                                Command="{Binding #MarkersItemsControl.((vm:ScheduleEditorViewModel)DataContext).RemoveMarkerCommand}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <TextBlock Classes="dim" Foreground="IndianRed" Text="{Binding Error}"
                                               IsVisible="{Binding Error, Converter={x:Static convA:ObjectConverters.IsNotNull}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Add marker" Command="{Binding AddMarkerCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button Content="Save" Command="{Binding SaveCommand}" />
            <Button Content="Cancel" Click="OnCancelClick" />
            <TextBlock Classes="dim" Foreground="IndianRed" Text="{Binding ErrorMessage}" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
