<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chisel.App.App"
             xmlns:local="using:Chisel.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <Color x:Key="WindowBackgroundColor">#14161A</Color>
        <Color x:Key="CardBackgroundColor">#1F222A</Color>
        <Color x:Key="AccentColor">#5B8DEF</Color>
        <Color x:Key="DimTextColor">#8A8F98</Color>

        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="DimTextBrush" Color="{StaticResource DimTextColor}" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style Selector="TextBlock.cardHeading">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style Selector="TextBlock.empty">
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="TextBlock.dim">
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="TextBlock.done">
            <Setter Property="TextDecorations" Value="Strikethrough" />
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
        </Style>

        <Style Selector="Button.iconButton">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style Selector="Button.gearButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6" />
        </Style>

        <Style Selector="Border.settingsPanel">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 6 24 0 #80000000" />
        </Style>

        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Border.timelineRow">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style Selector="Border.timelineRow.current">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style Selector="Border.timelineRow.current TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style Selector="Border.timelineRow.past">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <Style Selector="TextBlock.timeLabel">
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
        </Style>

        <Style Selector="Border.timelineRow.current TextBlock.timeLabel">
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Application.Styles>
</Application>
