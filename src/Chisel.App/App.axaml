<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chisel.App.App"
             xmlns:local="using:Chisel.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <Color x:Key="WindowBackgroundColor">#14161A</Color>
        <Color x:Key="CardBackgroundColor">#1F222A</Color>
        <Color x:Key="AccentColor">#5B8DEF</Color>
        <Color x:Key="DimTextColor">#8A8F98</Color>

        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="DimTextBrush" Color="{StaticResource DimTextColor}" />
        <SolidColorBrush x:Key="GridLineBrush" Color="#2A2E37" />
        <SolidColorBrush x:Key="HoverLineBrush" Color="#3D4350" />
        <SolidColorBrush x:Key="EditPageBrush" Color="#181D28" />
        <SolidColorBrush x:Key="EditBarBrush" Color="#273149" />
        <SolidColorBrush x:Key="DragPreviewBrush" Color="#405B8DEF" />
        <!-- Block colors and text come from the chosen palette (Models/BlockPalette.cs).
             BlockPaletteTests checks this outline stands out on every fill of every palette. -->
        <Color x:Key="CurrentBlockOutlineColor">#F2F4F8</Color>
        <SolidColorBrush x:Key="CurrentBlockOutlineBrush" Color="{StaticResource CurrentBlockOutlineColor}" />
        <SolidColorBrush x:Key="CheckpointBrush" Color="#E06C75" />
        <SolidColorBrush x:Key="ReminderBrush" Color="#C9B77A" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- Widget frames: a card with the widget's heading row; list widgets scroll inside the card.
             The 2px border is always there (transparent) so the edit-mode outline never moves anything. -->
        <Style Selector="Border.widgetFrame">
            <Setter Property="Padding" Value="0" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- Layout edit mode: accent outline, slim title bar with a grip, dimmed inert content, tinted page -->
        <Style Selector="Border.widgetFrame.editing">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style Selector="Border.widgetFrame.editing DockPanel.widgetContent">
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <!-- As tall as the heading row (12 + 32 + 6), so it covers the heading and its buttons exactly -->
        <Style Selector="Border.editBar">
            <Setter Property="Height" Value="50" />
            <Setter Property="Background" Value="{StaticResource EditBarBrush}" />
            <Setter Property="CornerRadius" Value="8,8,0,0" />
            <Setter Property="BorderBrush" Value="#405B8DEF" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style Selector="StackPanel.editBarContent">
            <Setter Property="Spacing" Value="10" />
            <Setter Property="Margin" Value="14,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Path.editGrip">
            <Setter Property="Fill" Value="{StaticResource DimTextBrush}" />
        </Style>

        <Style Selector="TextBlock.editTitle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Dragging a widget: its card stays put but faded, a ghost of its title bar follows the pointer,
             and a slim accent line marks the landing spot -->
        <!-- The card being moved: faded, but its title bar stays opaque so the heading under it never shows through -->
        <Style Selector="Border.widgetFrame.dragSource">
            <Setter Property="BorderBrush" Value="#665B8DEF" />
        </Style>

        <Style Selector="Border.widgetFrame.dragSource DockPanel.widgetContent">
            <Setter Property="Opacity" Value="0.2" />
        </Style>

        <Style Selector="Border.widgetFrame.dragSource StackPanel.editBarContent">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <Style Selector="Border.dropIndicator">
            <Setter Property="Height" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BoxShadow" Value="0 0 8 0 #805B8DEF" />
        </Style>

        <Style Selector="Border.dragGhost">
            <Setter Property="Height" Value="50" />
            <Setter Property="Background" Value="{StaticResource EditBarBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Opacity" Value="0.92" />
            <Setter Property="BoxShadow" Value="0 8 24 0 #A0000000" />
        </Style>

        <!-- "New column" zones: a thin faint strip in each gap while dragging; the hovered one lights up -->
        <Style Selector="Border.newColumnZone">
            <Setter Property="Width" Value="6" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="#335B8DEF" />
        </Style>

        <Style Selector="Border.newColumnZone.active">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BoxShadow" Value="0 0 12 1 #995B8DEF" />
        </Style>

        <Style Selector="Border.newColumnLabel">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="BoxShadow" Value="0 4 12 0 #80000000" />
        </Style>

        <Style Selector="Border.newColumnLabel TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Resize handles in the gaps between stacked cards: invisible outside edit mode; in edit mode a faint
             line with a short accent grip, brighter on hover and while dragging -->
        <Style Selector="Panel.resizeHandle Border.resizeLine">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#265B8DEF" />
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="Panel.resizeHandle Border.resizeGrip">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#995B8DEF" />
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="Panel.resizeHandle.editing Border.resizeLine, Panel.resizeHandle.editing Border.resizeGrip">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="Panel.resizeHandle Border.resizeHit">
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Panel.resizeHandle.editing:pointerover Border.resizeGrip, Panel.resizeHandle.active Border.resizeGrip">
            <Setter Property="Width" Value="64" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style Selector="Panel.resizeHandle.active Border.resizeLine">
            <Setter Property="Background" Value="#805B8DEF" />
        </Style>

        <Style Selector="Panel.page.editing">
            <Setter Property="Background" Value="{StaticResource EditPageBrush}" />
        </Style>

        <Style Selector="Border.layoutToolbar">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,-14,0,0" />
            <Setter Property="BoxShadow" Value="0 6 20 0 #80000000" />
        </Style>

        <Style Selector="Grid.widgetHeader">
            <Setter Property="Margin" Value="16,12,12,6" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <!-- Top-aligned so a list's input row stays right under the list, as before, when the card is taller -->
        <Style Selector=":is(UserControl).scrolledWidget">
            <Setter Property="Margin" Value="16,0,16,16" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style Selector="TextBlock.cardHeading">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style Selector="TextBlock.empty">
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="TextBlock.dim">
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="TextBlock.done">
            <Setter Property="TextDecorations" Value="Strikethrough" />
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
        </Style>

        <Style Selector="Button.iconButton">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style Selector="Button.gearButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6" />
        </Style>

        <Style Selector="Button.gearButton Path">
            <Setter Property="Fill" Value="{StaticResource DimTextBrush}" />
        </Style>

        <Style Selector="Button.gearButton.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#335B8DEF" />
        </Style>

        <!-- Disabled (the gear while editing): no grey box, just a faded icon -->
        <Style Selector="Button.gearButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.gearButton:disabled Path">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <Style Selector="Button.gearButton.active Path">
            <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style Selector="Border.settingsPanel">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 6 24 0 #80000000" />
        </Style>

        <!-- Settings: section headings and the palette chooser -->
        <Style Selector="TextBlock.settingsSection">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.6" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style Selector="ListBox.paletteList">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="ListBox.paletteList ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource GridLineBrush}" />
        </Style>

        <Style Selector="ListBox.paletteList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2A5B8DEF" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style Selector="Border.paletteChip">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="10" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>

        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Border.editorPanel">
            <Setter Property="Width" Value="320" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,10,14,0" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 6 24 0 #80000000" />
        </Style>

        <!-- Clickable grid items: a bare button around a block or marker pill, no button chrome -->
        <Style Selector="Button.gridItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.gridItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.gridItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Button.gridItem:pressed">
            <Setter Property="RenderTransform" Value="{x:Null}" />
        </Style>

        <Style Selector="Button.gridItem:pointerover Border.gridBlock">
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
        </Style>

        <Style Selector="Button.gridItem:pointerover Border.markerPill">
            <Setter Property="Background" Value="{StaticResource GridLineBrush}" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Foreground" Value="IndianRed" />
        </Style>

        <Style Selector="TextBlock.editorError">
            <Setter Property="Foreground" Value="IndianRed" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Schedule day grid -->
        <Style Selector="Border.divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource GridLineBrush}" />
        </Style>

        <Style Selector="TextBlock.hourLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style Selector="Border.hourLine">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource GridLineBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Blocks: fill comes from the block's color; the inner border clips the stripe to the rounded corners -->
        <Style Selector="Border.gridBlock">
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Border.blockInner">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style Selector="Border.blockStripe">
            <Setter Property="Width" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style Selector="StackPanel.blockContent">
            <Setter Property="Margin" Value="11,3,8,3" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style Selector="Border.dragPreview TextBlock.blockTitle">
            <Setter Property="Foreground" Value="#ECEEF2" />
        </Style>

        <Style Selector="Border.dragPreview TextBlock.blockTime">
            <Setter Property="Foreground" Value="#BCC1CA" />
        </Style>

        <!-- The current block keeps its own color and gets a bright outline and soft glow instead -->
        <Style Selector="Border.gridBlock.current">
            <Setter Property="BorderBrush" Value="{StaticResource CurrentBlockOutlineBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BoxShadow" Value="0 0 10 1 #55FFFFFF" />
        </Style>

        <Style Selector="Border.gridBlock.past">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <Style Selector="TextBlock.blockTitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style Selector="Border.gridBlock.current TextBlock.blockTitle">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="TextBlock.blockTime">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style Selector="Line.markerLine">
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Stroke" Value="{StaticResource ReminderBrush}" />
            <Setter Property="StrokeDashArray" Value="1,3" />
        </Style>

        <Style Selector="Grid.markerRow.checkpoint Line.markerLine">
            <Setter Property="Stroke" Value="{StaticResource CheckpointBrush}" />
            <Setter Property="StrokeDashArray" Value="4,3" />
        </Style>

        <Style Selector="Border.markerPill">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ReminderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <Style Selector="Grid.markerRow.checkpoint Border.markerPill">
            <Setter Property="BorderBrush" Value="{StaticResource CheckpointBrush}" />
        </Style>

        <Style Selector="TextBlock.markerText">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource ReminderBrush}" />
        </Style>

        <Style Selector="Grid.markerRow.checkpoint TextBlock.markerText">
            <Setter Property="Foreground" Value="{StaticResource CheckpointBrush}" />
        </Style>

        <Style Selector="Grid.markerRow.past">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <!-- A marker not saved yet: same look, a little softer -->
        <Style Selector="Grid.markerRow.pendingMarker">
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <!-- Hover guide line: faint, a step above the hour lines, never competing with the now-line -->
        <Style Selector="Border.hoverLine">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource HoverLineBrush}" />
        </Style>

        <Style Selector="Border.hoverLabel">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="3,0" />
        </Style>

        <Style Selector="Border.hoverLabel TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <!-- Drag-to-create preview: translucent accent box; a little stronger once it is pending in the editor -->
        <Style Selector="Border.dragPreview">
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="{StaticResource DragPreviewBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Pending: the editor's color shows through the fill and stripe; the accent outline marks it unsaved -->
        <Style Selector="Border.dragPreview.pending">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Color picker swatches: a small dot; the selected one gets a ring -->
        <Style Selector="Button.swatch">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.swatch:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#66FFFFFF" />
        </Style>

        <Style Selector="Button.swatch.selected /template/ ContentPresenter#PART_ContentPresenter, Button.swatch.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource CurrentBlockOutlineBrush}" />
        </Style>

        <Style Selector="Ellipse.swatchDot">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>

        <Style Selector="Border.nowLine">
            <Setter Property="Height" Value="2" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Ellipse.nowDot">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="-4,0,0,0" />
        </Style>

        <Style Selector="Border.nowPill">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style Selector="Border.nowPill TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Application.Styles>
</Application>
