<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Chisel.App.ViewModels"
        xmlns:conv="using:Chisel.App.Converters"
        xmlns:ctl="using:Chisel.App.Controls"
        xmlns:convA="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
        x:Class="Chisel.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Background="{StaticResource WindowBackgroundBrush}"
        Title="Chisel">

    <Window.Styles>
        <!-- Items in a day grid get their place from the item's minutes and overlap column. -->
        <Style Selector="ItemsControl.dayGrid > ContentPresenter" x:DataType="vm:ScheduleGridItem">
            <Setter Property="ctl:DayGridPanel.StartMinute" Value="{Binding StartMinute}" />
            <Setter Property="ctl:DayGridPanel.EndMinute" Value="{Binding EndMinute}" />
            <Setter Property="ctl:DayGridPanel.Column" Value="{Binding Column}" />
            <Setter Property="ctl:DayGridPanel.ColumnCount" Value="{Binding ColumnCount}" />
        </Style>
    </Window.Styles>

    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CloseOverlaysCommand}" />
    </Window.KeyBindings>

    <Grid RowDefinitions="Auto,*" Margin="20" ColumnDefinitions="*">
        <Button Grid.Row="0" Name="SettingsButton" Classes="gearButton"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                ToolTip.Tip="Settings" Command="{Binding Settings.ToggleCommand}">
            <Path Width="20" Height="20" Stretch="Uniform" Fill="{StaticResource DimTextBrush}"
                  Data="M10.13,4.22 L10.52,1.60 L13.48,1.60 L13.87,4.22 L16.18,5.18 L18.30,3.60 L20.40,5.70 L18.82,7.82 L19.78,10.13 L22.40,10.52 L22.40,13.48 L19.78,13.87 L18.82,16.18 L20.40,18.30 L18.30,20.40 L16.18,18.82 L13.87,19.78 L13.48,22.40 L10.52,22.40 L10.13,19.78 L7.82,18.82 L5.70,20.40 L3.60,18.30 L5.18,16.18 L4.22,13.87 L1.60,13.48 L1.60,10.52 L4.22,10.13 L5.18,7.82 L3.60,5.70 L5.70,3.60 L7.82,5.18 Z M15.20,12 A3.2,3.2 0 1 0 8.80,12 A3.2,3.2 0 1 0 15.20,12 Z" />
        </Button>

        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="{Binding Clock.TimeText}" FontSize="36" FontWeight="Bold" />
                <TextBlock Text="{Binding Clock.Now, StringFormat='{}{0:dddd, MMMM d}'}" FontSize="20" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="dim" Text="{Binding Schedule.CurrentBlockTitle, StringFormat='Now: {0}'}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="1.3*,16,*">
            <!-- Schedule: a 24-hour day grid. Blocks are boxes sized by their times, markers are lines. -->
            <Border Grid.Column="0" Classes="card" Padding="0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="16,12,12,12">
                        <TextBlock Grid.Column="0" Classes="cardHeading" Text="Today" Margin="0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Name="NowButton" Content="Now" Click="OnNowClick" />
                            <Button Name="AddMarkerButton" Content="+ Marker" Command="{Binding Schedule.AddMarkerCommand}" />
                            <Button Name="AddBlockButton" Classes="accent" Content="+ Block" Command="{Binding Schedule.AddBlockCommand}" />
                        </StackPanel>
                    </Grid>
                    <Border DockPanel.Dock="Top" Classes="divider" />
                    <Panel>
                    <!-- Block editor: floats over the grid, under the header buttons -->
                    <Border Name="BlockEditorPanel" Classes="card editorPanel" ZIndex="10"
                            IsVisible="{Binding Schedule.BlockEditor.IsOpen}">
                        <Border.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding Schedule.BlockEditor.SaveCommand}" />
                        </Border.KeyBindings>
                        <StackPanel Spacing="8">
                            <TextBlock Classes="cardHeading" Text="{Binding Schedule.BlockEditor.Heading}" Margin="0" />
                            <TextBlock Classes="dim" Text="Title" />
                            <TextBox Name="BlockTitleBox" Text="{Binding Schedule.BlockEditor.Title}" PlaceholderText="What are you doing?" />
                            <Grid ColumnDefinitions="*,10,*">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Classes="dim" Text="Start" />
                                    <TextBox Name="BlockStartBox" Text="{Binding Schedule.BlockEditor.StartText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Classes="dim" Text="End" />
                                    <TextBox Name="BlockEndBox" Text="{Binding Schedule.BlockEditor.EndText}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Name="BlockEditorError" Classes="editorError" Text="{Binding Schedule.BlockEditor.ErrorMessage}"
                                       IsVisible="{Binding Schedule.BlockEditor.ErrorMessage, Converter={x:Static convA:ObjectConverters.IsNotNull}}" />
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Button Name="BlockDeleteButton" Classes="danger" Content="Delete"
                                        Command="{Binding Schedule.BlockEditor.DeleteCommand}"
                                        IsVisible="{Binding Schedule.BlockEditor.IsEditing}" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                    <Button Name="BlockCancelButton" Content="Cancel" Command="{Binding Schedule.BlockEditor.CancelCommand}" />
                                    <Button Name="BlockSaveButton" Classes="accent" Content="Save" Command="{Binding Schedule.BlockEditor.SaveCommand}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Marker editor -->
                    <Border Name="MarkerEditorPanel" Classes="card editorPanel" ZIndex="10"
                            IsVisible="{Binding Schedule.MarkerEditor.IsOpen}">
                        <Border.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding Schedule.MarkerEditor.SaveCommand}" />
                        </Border.KeyBindings>
                        <StackPanel Spacing="8">
                            <TextBlock Classes="cardHeading" Text="{Binding Schedule.MarkerEditor.Heading}" Margin="0" />
                            <TextBlock Classes="dim" Text="Label" />
                            <TextBox Name="MarkerLabelBox" Text="{Binding Schedule.MarkerEditor.Label}" PlaceholderText="What happens then?" />
                            <Grid ColumnDefinitions="*,10,*">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Classes="dim" Text="Time" />
                                    <TextBox Name="MarkerTimeBox" Text="{Binding Schedule.MarkerEditor.TimeText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Classes="dim" Text="Kind" />
                                    <ComboBox Name="MarkerKindBox" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding Schedule.MarkerEditor.Kinds}"
                                              SelectedItem="{Binding Schedule.MarkerEditor.Kind}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Name="MarkerEditorError" Classes="editorError" Text="{Binding Schedule.MarkerEditor.ErrorMessage}"
                                       IsVisible="{Binding Schedule.MarkerEditor.ErrorMessage, Converter={x:Static convA:ObjectConverters.IsNotNull}}" />
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Button Name="MarkerDeleteButton" Classes="danger" Content="Delete"
                                        Command="{Binding Schedule.MarkerEditor.DeleteCommand}"
                                        IsVisible="{Binding Schedule.MarkerEditor.IsEditing}" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                    <Button Name="MarkerCancelButton" Content="Cancel" Command="{Binding Schedule.MarkerEditor.CancelCommand}" />
                                    <Button Name="MarkerSaveButton" Classes="accent" Content="Save" Command="{Binding Schedule.MarkerEditor.SaveCommand}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Name="ScheduleScroller" HorizontalScrollBarVisibility="Disabled"
                                  PointerMoved="OnSchedulePointerMoved" PointerExited="OnSchedulePointerExited"
                                  ScrollChanged="OnScheduleScrollChanged">
                        <!-- Transparent background so clicks on empty space reach the grid -->
                        <Grid Name="ScheduleGrid" ColumnDefinitions="76,*" Margin="0,14,14,14" Background="Transparent"
                              PointerPressed="OnScheduleGridPointerPressed">
                            <!-- Hour rows: label on the left, faint line across -->
                            <ItemsControl Grid.ColumnSpan="2" Classes="dayGrid" ItemsSource="{Binding Schedule.HourLabels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><ctl:DayGridPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScheduleHourLabel">
                                        <Grid ColumnDefinitions="76,*">
                                            <TextBlock Classes="hourLabel" Text="{Binding Text}" />
                                            <Border Grid.Column="1" Classes="hourLine" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl Name="ScheduleBlocks" Grid.Column="1" Classes="dayGrid" ItemsSource="{Binding Schedule.GridBlocks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><ctl:DayGridPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScheduleGridBlock">
                                        <Button Classes="gridItem" ToolTip.Tip="Edit block"
                                                Command="{Binding #ScheduleBlocks.((vm:MainViewModel)DataContext).Schedule.EditBlockCommand}"
                                                CommandParameter="{Binding}">
                                            <Border Classes="gridBlock" Classes.current="{Binding IsCurrent}" Classes.past="{Binding IsPast}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Classes="blockTitle" Text="{Binding Title}" />
                                                        <TextBlock Classes="blockTime" Text="{Binding TimeLabel}" VerticalAlignment="Center"
                                                                   IsVisible="{Binding IsShort}" />
                                                    </StackPanel>
                                                    <TextBlock Classes="blockTime" Text="{Binding TimeLabel}" IsVisible="{Binding !IsShort}" />
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Hover guide line: where a click on empty space adds a block. Label sits just above its left end. -->
                            <ctl:DayGridPanel Grid.Column="1" IsHitTestVisible="False">
                                <Panel Name="HoverLine" Height="1" ctl:DayGridPanel.StartMinute="{Binding Schedule.HoverMinute}"
                                       IsVisible="{Binding Schedule.IsHoverVisible}">
                                    <Border Classes="hoverLine" />
                                    <Canvas>
                                        <Border Classes="hoverLabel" Canvas.Left="4" Canvas.Bottom="1">
                                            <TextBlock Name="HoverLabel" Text="{Binding Schedule.HoverLabel}" />
                                        </Border>
                                    </Canvas>
                                </Panel>
                            </ctl:DayGridPanel>

                            <ItemsControl Name="ScheduleMarkers" Grid.Column="1" Classes="dayGrid" ItemsSource="{Binding Schedule.GridMarkers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><ctl:DayGridPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScheduleGridMarker">
                                        <Grid Classes="markerRow" Classes.checkpoint="{Binding IsCheckpoint}" Classes.past="{Binding IsPast}"
                                              ColumnDefinitions="*,Auto">
                                            <!-- Only the pill is clickable; the line lets clicks through to blocks underneath. -->
                                            <Panel ClipToBounds="True" VerticalAlignment="Center" Height="2" IsHitTestVisible="False">
                                                <Line Classes="markerLine" StartPoint="0,1" EndPoint="4000,1" />
                                            </Panel>
                                            <Button Grid.Column="1" Classes="gridItem" ToolTip.Tip="Edit marker"
                                                    Command="{Binding #ScheduleMarkers.((vm:MainViewModel)DataContext).Schedule.EditMarkerCommand}"
                                                    CommandParameter="{Binding}">
                                                <Border Classes="markerPill">
                                                    <TextBlock Classes="markerText">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0}  {1}">
                                                                <Binding Path="TimeLabel" />
                                                                <Binding Path="Label" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </Border>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Now line -->
                            <ctl:DayGridPanel Grid.ColumnSpan="2" IsHitTestVisible="False">
                                <Grid Name="NowLine" ctl:DayGridPanel.StartMinute="{Binding Schedule.NowMinute}" ColumnDefinitions="76,*">
                                    <Border Grid.Column="1" Classes="nowLine" />
                                    <Ellipse Grid.Column="1" Classes="nowDot" />
                                    <Border Classes="nowPill">
                                        <TextBlock Text="{Binding Schedule.NowLabel}" />
                                    </Border>
                                </Grid>
                            </ctl:DayGridPanel>
                        </Grid>
                    </ScrollViewer>
                    </Panel>
                </DockPanel>
            </Border>

            <!-- Tasks, Notes, Quick links: scrolls so the inputs stay reachable on short windows -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Name="SidePanel" Spacing="16" Margin="0,0,14,0">
                <Border Classes="card">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="cardHeading" Text="Tasks" />
                            <Button Grid.Column="1" Content="Clear completed" Command="{Binding Tasks.ClearCompletedCommand}" />
                        </Grid>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="4" Margin="0,10,0,0">
                            <TextBox Text="{Binding Tasks.NewTaskText}" PlaceholderText="New task" Width="160">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding Tasks.AddTaskCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <Button Content="Add" Command="{Binding Tasks.AddTaskCommand}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Classes="empty" Text="No tasks yet"
                                       IsVisible="{Binding Tasks.Tasks.Count, Converter={x:Static conv:IsZeroConverter.Instance}}" />
                            <ItemsControl Name="TaskItemsControl" ItemsSource="{Binding Tasks.Tasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                            <CheckBox IsChecked="{Binding IsDone}"
                                                      Command="{Binding #TaskItemsControl.((vm:MainViewModel)DataContext).Tasks.ToggleCompleteCommand}"
                                                      CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding Text}" Classes.done="{Binding IsDone}" VerticalAlignment="Center" />
                                            <Button Classes="iconButton" Content="x"
                                                    Command="{Binding #TaskItemsControl.((vm:MainViewModel)DataContext).Tasks.RemoveTaskCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Classes="card">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Classes="cardHeading" Text="Notes" />
                        <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,10,0,0">
                            <TextBox Text="{Binding Notes.NewNoteTitle}" PlaceholderText="Title" />
                            <TextBox Text="{Binding Notes.NewNoteBody}" PlaceholderText="Body" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Content="Save" Command="{Binding Notes.SaveNoteCommand}" />
                                <Button Content="Cancel" Command="{Binding Notes.CancelEditCommand}"
                                        IsVisible="{Binding Notes.EditingNoteId, Converter={x:Static convA:ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Classes="empty" Text="No notes yet"
                                       IsVisible="{Binding Notes.Notes.Count, Converter={x:Static conv:IsZeroConverter.Instance}}" />
                            <ItemsControl Name="NoteItemsControl" ItemsSource="{Binding Notes.Notes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NoteRow">
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                            <Button Classes="link" HorizontalAlignment="Left"
                                                    Command="{Binding #NoteItemsControl.((vm:MainViewModel)DataContext).Notes.SelectNoteCommand}"
                                                    CommandParameter="{Binding Note}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="White" />
                                                    <TextBlock Classes="dim" Text="{Binding Body}" />
                                                    <TextBlock Classes="dim" FontSize="11" Text="{Binding UpdatedLabel}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="iconButton" Content="x"
                                                    Command="{Binding #NoteItemsControl.((vm:MainViewModel)DataContext).Notes.RemoveNoteCommand}"
                                                    CommandParameter="{Binding Note}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Classes="card">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Classes="cardHeading" Text="Quick links" />
                        <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,10,0,0">
                            <TextBox Text="{Binding QuickLinks.NewLinkLabel}" PlaceholderText="Label" />
                            <TextBox Text="{Binding QuickLinks.NewLinkUrl}" PlaceholderText="https://..." />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Content="Save" Command="{Binding QuickLinks.SaveQuickLinkCommand}" />
                                <Button Content="Cancel" Command="{Binding QuickLinks.CancelEditCommand}"
                                        IsVisible="{Binding QuickLinks.EditingLinkId, Converter={x:Static convA:ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                            <TextBlock Classes="dim" Foreground="IndianRed" Text="{Binding QuickLinks.ErrorMessage}"
                                       IsVisible="{Binding QuickLinks.ErrorMessage, Converter={x:Static convA:ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Classes="empty" Text="No quick links yet"
                                       IsVisible="{Binding QuickLinks.QuickLinks.Count, Converter={x:Static conv:IsZeroConverter.Instance}}" />
                            <ItemsControl Name="QuickLinkItemsControl" ItemsSource="{Binding QuickLinks.QuickLinks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                            <Button Classes="link" Content="{Binding Label}"
                                                    Command="{Binding #QuickLinkItemsControl.((vm:MainViewModel)DataContext).QuickLinks.OpenQuickLinkCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Classes="iconButton" Content="e"
                                                    Command="{Binding #QuickLinkItemsControl.((vm:MainViewModel)DataContext).QuickLinks.SelectQuickLinkCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Classes="iconButton" Content="x"
                                                    Command="{Binding #QuickLinkItemsControl.((vm:MainViewModel)DataContext).QuickLinks.RemoveQuickLinkCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Settings panel: floats over the content, below the gear button -->
        <Border Grid.Row="0" Grid.RowSpan="2" Name="SettingsPanel" Classes="card settingsPanel"
                IsVisible="{Binding Settings.IsOpen}" ZIndex="10"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,44,0,0" Width="280">
            <StackPanel Spacing="10">
                <TextBlock Classes="cardHeading" Text="Settings" />
                <TextBlock Classes="dim" Text="Clock format" />
                <RadioButton GroupName="ClockFormat" Content="24-hour (13:05)" IsChecked="{Binding Settings.UseTwentyFourHour}" />
                <RadioButton GroupName="ClockFormat" Content="12-hour (1:05 PM)" IsChecked="{Binding Settings.UseTwelveHour}" />
                <Button Content="Close" HorizontalAlignment="Right" Command="{Binding Settings.CloseCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
